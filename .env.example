# ============================================================
# .env.example — template do .env global (raiz do projeto)
# Copie para .env e preencha: cp .env.example .env
# ============================================================

# PostgreSQL — credenciais do container do compose (exposto em localhost:5433)
DATABASE_URL=postgres://erp:erp123@localhost:5433/erp

# Segurança — TROQUE este segredo antes de subir em produção
JWT_SECRET=troque-este-segredo

# CORS do frontend em dev
CORS_ORIGIN=http://localhost:5173

# IA (NVIDIA NIM) — opcional
NVIDIA_API_KEY=

# Admin inicial (criado via create-admin)
ADMIN_EMAIL=admin@erp.com
ADMIN_PASSWORD=Admin@123
ADMIN_NAME=Administrador
